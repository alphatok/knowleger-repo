<input class="search" id="q" placeholder="搜索标题 / 标签 / 摘要…">
<div class="cats" id="cats"><span class="chip on" data-cat="">全部</span>{chips}</div>
<div id="list">{"".join(cards) or '<p class="hint">知识库还是空的，先用 <code>kb add</code> 采集片段吧。</p>'}</div>
<script>
const q=document.getElementById('q'),list=document.getElementById('list');
let cat='';
document.querySelectorAll('.chip').forEach(ch=>ch.onclick=()=>{{
  document.querySelectorAll('.chip').forEach(c=>c.classList.remove('on'));
  ch.classList.add('on');cat=ch.dataset.cat;flt();}});
function flt(){{const k=q.value.trim().toLowerCase();
  list.querySelectorAll('.card').forEach(c=>{{
    const okk=!k||c.dataset.k.includes(k);
    const okc=!cat||c.dataset.cat===cat;
    c.style.display=(okk&&okc)?'':'none';}});}}
q.oninput=flt;
</script>"""
    write(DOCS / "index.html", PAGE.format(title="知识库", css="style.css", home="index.html",
                                           graph="graph.html", content=index_html))

    # 每篇笔记
    for n in notes:
        # 反链
        back = [m for m in notes if n["title"] in m["links"] and m["slug"] != n["slug"]]
        back_html = ""
        if back:
            back_html = "<h2>反向链接</h2><ul>" + "".join(
                f'<li><a href="{m["slug"]}.html">{html.escape(m["title"])}</a></li>' for m in back) + "</ul>"
        tags = "".join(f'<span class="tag">#{html.escape(t)}</span>' for t in n["tags"])
        content = (f'<div class="crumb">{html.escape(n["category"])} · {html.escape(n["status"])} · {html.escape(n["updated"])} {tags}</div>'
                   f"<h1>{html.escape(n['title'])}</h1>{n['html']}{back_html}")
        write(DOCS / "note" / f'{n["slug"]}.html',
              PAGE.format(title=n["title"], css="../style.css", home="../index.html",
                          graph="../graph.html", content=content))

    # 图谱
    nodes = [{"id": n["slug"], "t": n["title"], "c": n["category"], "u": f'note/{n["slug"]}.html'} for n in notes]
    title2slug = {n["title"]: n["slug"] for n in notes}
    edges = []
    seen_edge = set()
    for n in notes:
        for lk in n["links"]:
            if lk in title2slug and title2slug[lk] != n["slug"]:
                key = (n["slug"], title2slug[lk])
                if key not in seen_edge:
                    seen_edge.add(key)
                    edges.append([key[0], key[1]])
    graph_html = f"""<h1>知识图谱</h1>
<p class="hint">节点=笔记，连线=引用关系。拖拽可平移，滚轮缩放，点击节点跳转。</p>
<canvas id="graph"></canvas>
<script>
const N={json.dumps(nodes,ensure_ascii=False)},E={json.dumps(edges,ensure_ascii=False)};
const cv=document.getElementById('graph'),ctx=cv.getContext('2d');
let dpr=devicePixelRatio||1,W=0,H=0,scale=1,ox=0,oy=0,pos={{}};
const cats=[...new Set(N.map(n=>n.c))];const col={{}};
const pal=['#3b5bdb','#0ca678','#e8590c','#9c36b5','#c2255c','#1c7ed6','#f08c00','#2f9e44'];
cats.forEach((c,i)=>col[c]=pal[i%pal.length]);
// 按分类分扇区布局
function layout(){{const R=(Math.min(W,H)*0.38)||220;pos={{}};
  cats.forEach((c,ci)=>{{const group=N.filter(n=>n.c===c);const a0=ci/cats.length*Math.PI*2;
    group.forEach((n,i)=>{{const a=a0+(i+0.5)/group.length*(Math.PI*2/cats.length);
      const r=R*(0.5+0.5*((i%3)/2));pos[n.id]={{x:Math.cos(a)*r,y:Math.sin(a)*r}};}});}});}}
function resize(){{W=cv.clientWidth;H=cv.clientHeight;cv.width=W*dpr;cv.height=H*dpr;ctx.setTransform(dpr,0,0,dpr,0,0);layout();draw();}}
addEventListener('resize',resize);
let drag=false,px,py;
cv.onmousedown=e=>{{drag=true;px=e.clientX;py=e.clientY;}};
addEventListener('mouseup',()=>drag=false);
addEventListener('mousemove',e=>{{if(!drag)return;ox+=e.clientX-px;oy+=e.clientY-py;px=e.clientX;py=e.clientY;draw();}});
cv.onwheel=e=>{{e.preventDefault();scale*=e.deltaY<0?1.1:0.9;draw();}};
cv.onclick=e=>{{const r=cv.getBoundingClientRect();const x=(e.clientX-r.left-W/2-ox)/scale,y=(e.clientY-r.top-H/2-oy)/scale;
  let best=null,bd=1e9;N.forEach(n=>{{const p=pos[n.id];const d=(p.x-x)**2+(p.y-y)**2;if(d<bd){{bd=d;best=n;}}}});
  if(best&&bd<2500)location.href=best.u;}};
function draw(){{ctx.clearRect(0,0,W,H);ctx.save();ctx.translate(W/2+ox,H/2+oy);ctx.scale(scale,scale);
  ctx.strokeStyle='rgba(127,127,127,.28)';ctx.lineWidth=1;
  E.forEach(([a,b])=>{{if(!pos[a]||!pos[b])return;ctx.beginPath();ctx.moveTo(pos[a].x,pos[a].y);ctx.lineTo(pos[b].x,pos[b].y);ctx.stroke();}});
  N.forEach(n=>{{const p=pos[n.id];ctx.beginPath();ctx.arc(p.x,p.y,6,0,7);ctx.fillStyle=col[n.c];ctx.fill();
    ctx.fillStyle=getComputedStyle(document.body).color;ctx.font='12px sans-serif';ctx.textAlign='center';
    ctx.fillText(n.t.length>14?n.t.slice(0,13)+'…':n.t,p.x,p.y+20);}});
  ctx.restore();}}
resize();
</script>"""
    write(DOCS / "graph.html", PAGE.format(title="知识图谱", css="style.css", home="index.html",
                                           graph="graph.html", content=graph_html))

    print(GRN(f"✓ 站点已生成：{rel(DOCS)}/index.html（{len(notes)} 篇笔记，{len(edges)} 条链接）"))
    if args.open:
        subprocess.call(["open", str(DOCS / "index.html")])
    return 0

# ---------------------------------------------------------------- 入口

def main():
    ap = argparse.ArgumentParser(prog="kb", description="knowleger-repo 知识库 CLI")
    sub = ap.add_subparsers(dest="cmd")

    p = sub.add_parser("add", help="采集零星片段")
    p.add_argument("text", nargs="?", help="片段内容；省略则从 stdin 读")
    p.add_argument("-f", "--file", help="从文件读取")
    p.add_argument("-s", "--source", help="来源标注")
    p.set_defaults(func=cmd_add)

    p = sub.add_parser("new", help="新建结构化笔记")
    p.add_argument("category"); p.add_argument("title")
    p.add_argument("--agent", default="human"); p.add_argument("--force", action="store_true")
    p.set_defaults(func=cmd_new)

    sub.add_parser("status", help="知识库状态").set_defaults(func=cmd_status)

    p = sub.add_parser("process", help="生成 Ingest 整理任务")
    p.add_argument("--run", action="store_true", help="直接调用 AI CLI 执行（默认 opencode run）")
    p.add_argument("--local", action="store_true", help="用本地 Ollama 模型执行（零 API 成本）")
    p.add_argument("-o", "--out", help="把任务写到文件")
    p.set_defaults(func=cmd_process, local=False)

    p = sub.add_parser("ask", help="生成 Query 问答任务（检索 + 引用作答 + 回写）")
    p.add_argument("question")
    p.add_argument("-n", "--context", type=int, default=6, help="自动检索多少条素材")
    p.add_argument("--fast", action="store_true", help="用 BM25 快速检索（默认混合检索+重排）")
    p.add_argument("--run", action="store_true", help="直接调用 AI CLI 执行")
    p.add_argument("--local", action="store_true", help="用本地 Ollama 模型执行")
    p.add_argument("-o", "--out", help="把任务写到文件")
    p.set_defaults(func=cmd_ask, local=False)

    p = sub.add_parser("pattern", help="用 fabric 的 pattern 处理文本")
    p.add_argument("name", nargs="?", help="pattern 名字，如 extract_wisdom")
    p.add_argument("text", nargs="?", help="要处理的文本；省略则从 stdin 读")
    p.add_argument("-f", "--file", help="从文件读取")
    p.add_argument("-l", "--list", action="store_true", help="列出所有可用 pattern")
    p.add_argument("-m", "--model", help="指定模型")
    p.add_argument("-s", "--stream", action="store_true", help="流式输出")
    p.add_argument("--no-save", action="store_true", help="不另存结果")
    p.add_argument("--timeout", type=int, default=600)
    p.set_defaults(func=cmd_pattern)

    sub.add_parser("doctor", help="检查本地工具链").set_defaults(func=cmd_doctor)

    p = sub.add_parser("archive", help="归档已整理的片段")
    p.add_argument("files", nargs="*")
    p.set_defaults(func=cmd_archive)

    p = sub.add_parser("index", help="重建主题地图 MOC，并刷新本地检索索引")
    p.add_argument("--embed", action="store_true", help="同时重建向量索引（qmd embed，较慢）")
    p.set_defaults(func=cmd_index)

    sub.add_parser("lint", help="知识体检").set_defaults(func=cmd_lint)

    p = sub.add_parser("build", help="生成静态站点")
    p.add_argument("--open", action="store_true", help="生成后打开浏览器")
    p.set_defaults(func=cmd_build)

    p = sub.add_parser("find", help="本地检索（QMD 混合检索 / 全文匹配）")
    p.add_argument("keyword")
    p.add_argument("-n", "--max", type=int, default=6, help="最多返回几条")
    p.add_argument("-a", "--all", action="store_true", help="全文模式：连同归档一起搜")
    p.add_argument("--deep", action="store_true", help="混合检索 + LLM 重排（质量最好，稍慢）")
    p.add_argument("--semantic", action="store_true", help="纯向量语义检索")
    p.add_argument("--grep", dest="engine", action="store_const", const="grep", help="强制全文匹配")
    p.set_defaults(func=cmd_find, engine="auto")

    p = sub.add_parser("log", help="查看整理台账")
    p.add_argument("-n", type=int, default=20)
    p.set_defaults(func=cmd_log)

    args = ap.parse_args()
    if not getattr(args, "func", None):
        ap.print_help(); return 0
    return args.func(args)

if __name__ == "__main__":
    sys.exit(main())
