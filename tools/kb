DOCS = ROOT / "docs"
LEDGER = META / "ledger.jsonl"
TAXONOMY = META / "taxonomy.md"
AGENTS = ROOT / "AGENTS.md"

AUTOGEN = "<!-- AUTO-GENERATED by `kb index` — 请勿手改，改内容后重新运行 kb index -->"

# ---------------------------------------------------------------- 终端颜色

def _tty():
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None

def c(s, col):
    return f"\033[{col}m{s}\033[0m" if _tty() else str(s)

DIM = lambda s: c(s, "2")
BOLD = lambda s: c(s, "1")
RED = lambda s: c(s, "31")
GRN = lambda s: c(s, "32")
YEL = lambda s: c(s, "33")
CYA = lambda s: c(s, "36")
MAG = lambda s: c(s, "35")

# ---------------------------------------------------------------- 基础工具

def read(p: Path) -> str:
    return p.read_text(encoding="utf-8")

def write(p: Path, s: str):
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(s, encoding="utf-8")

def now_iso() -> str:
    return dt.datetime.now().astimezone().replace(microsecond=0).isoformat()

def today() -> str:
    return dt.date.today().isoformat()

def hhmmss() -> str:
    return dt.datetime.now().strftime("%H:%M:%S")

FM_RE = re.compile(r"^---\n(.*?)\n---[ \t]*\n?", re.S)

def parse_value(v: str):
    v = v.strip()
    if v.startswith("[") and v.endswith("]"):
        inner = v[1:-1].strip()
        if not inner:
            return []
        return [x.strip().strip("'\"") for x in inner.split(",")]
    return v.strip().strip("'\"")

def parse_frontmatter(text: str):
    """返回 (frontmatter dict, body)。无 frontmatter 时返回 ({}, 原文)。"""
    m = FM_RE.match(text)
    if not m:
        return {}, text
    fm = {}
    for line in m.group(1).splitlines():
        if not line.strip() or line.lstrip().startswith("#") or ":" not in line:
            continue
        k, v = line.split(":", 1)
        fm[k.strip()] = parse_value(v)
    return fm, text[m.end():]

FM_ORDER = ["id", "title", "category", "tags", "status", "created", "updated", "sources", "related"]

def dump_frontmatter(fm: dict) -> str:
    keys = [k for k in FM_ORDER if k in fm] + [k for k in fm if k not in FM_ORDER]
    lines = ["---"]
    for k in keys:
        v = fm[k]
        if isinstance(v, list):
            lines.append(f"{k}: [{', '.join(str(x) for x in v)}]")
        else:
            lines.append(f"{k}: {v}")
    lines.append("---")
    return "\n".join(lines) + "\n"

def slugify(s: str) -> str:
    s = s.strip().replace("/", "／")
    s = re.sub(r"\s+", "-", s)
    s = re.sub(r"[\"'`\\:*?<>|\n\r\t]+", "", s)
    return s[:120]

def rel(p: Path) -> str:
    try:
        return str(p.relative_to(ROOT))
    except ValueError:
        return str(p)

def iter_notes():
    """遍历知识库笔记，返回 (path, fm, body)。"""
    if not KNOWLEDGE.exists():
        return
    for p in sorted(KNOWLEDGE.rglob("*.md")):
        if p.name.startswith("_") or p.name.startswith("."):
            continue
        fm, body = parse_frontmatter(read(p))
        yield p, fm, body

def note_title(p: Path, fm: dict) -> str:
    return str(fm.get("title") or p.stem)

def note_summary(body: str, n: int = 120) -> str:
    for line in body.splitlines():
        s = line.strip()
        if not s or s.startswith("#") or s.startswith(">") or s.startswith("```"):
            continue
        s = re.sub(r"\[\[([^\]|]+)(?:\|([^\]]+))?\]\]", lambda m: m.group(2) or m.group(1), s)
        s = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", s)
        s = re.sub(r"[*`]", "", s)
        return s[:n] + ("…" if len(s) > n else "")
    return ""

def categories() -> list:
    if not KNOWLEDGE.exists():
        return []
    return sorted([d.name for d in KNOWLEDGE.iterdir() if d.is_dir() and not d.name.startswith(".")])

def load_ledger() -> list:
    if not LEDGER.exists():
        return []
    out = []
    for line in read(LEDGER).splitlines():
        line = line.strip()
        if line:
            try:
                out.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    return out

def append_ledger(entry: dict):
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    with LEDGER.open("a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")

# ---------------------------------------------------------------- 外部工具

CONFIG_FILE = ROOT / ".kbconfig.json"
DEFAULT_CONFIG = {
    "agent_cmd": "opencode run",
    "local_model": "qwen3:8b",
    "local_agent_cmd": "ollama run {model}",
}

def load_config() -> dict:
    cfg = dict(DEFAULT_CONFIG)
    if CONFIG_FILE.exists():
        try:
            cfg.update(json.loads(read(CONFIG_FILE)))
        except json.JSONDecodeError:
            print(YEL(f"⚠ {rel(CONFIG_FILE)} 不是合法 JSON，已忽略"))
    return cfg

def have(cmd: str) -> bool:
    return shutil.which(cmd) is not None

def run_capture(argv, timeout=None):
    """返回 (returncode, stdout, stderr)。"""
    try:
        p = subprocess.run([str(a) for a in argv], cwd=str(ROOT),
                           capture_output=True, text=True, timeout=timeout)
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", f"找不到命令：{argv[0]}"
    except subprocess.TimeoutExpired:
        return 124, "", "超时"

def run_stream(argv):
    try:
        return subprocess.call([str(a) for a in argv], cwd=str(ROOT))
    except FileNotFoundError:
        return 127

QMD_DIR = ROOT / ".qmd"

def qmd_ready() -> bool:
    return have("qmd") and QMD_DIR.exists()

def qmd_search(kw: str, mode: str, limit: int):
    """mode: lex | vec | hybrid。返回 (results, error)。"""
    sub = {"lex": "search", "vec": "vsearch", "hybrid": "query"}[mode]
    rc, out, err = run_capture(["qmd", sub, kw, "--json", "-n", str(limit)], timeout=300)
    if rc != 0:
        return None, (err or out or "").strip()[:300] or f"qmd {sub} 退出码 {rc}"
    try:
        return json.loads(out), None
    except json.JSONDecodeError:
        return None, "无法解析 qmd 的 JSON 输出"

def qmd_refresh():
    """让 QMD 重新索引（增量），失败静默返回 False。"""
    if not qmd_ready():
        return False
    rc, _, _ = run_capture(["qmd", "update"], timeout=300)
    return rc == 0

def qmd_embed():
    if not qmd_ready():
        return False
    rc, _, _ = run_capture(["qmd", "embed"], timeout=1800)
    return rc == 0

# ---------------------------------------------------------------- 断链解析

WIKI_RE = re.compile(r"\[\[([^\]|]+)(?:\|([^\]]+))?\]\]")

def build_link_resolver():
    """标题/别名/文件名 → 笔记相对路径。返回 resolve(target) -> relpath | None。"""
    table = {}
    for p, fm, body in iter_notes():
        r = rel(p)
        table.setdefault(note_title(p, fm), r)
        table.setdefault(p.stem, r)
        for a in fm.get("aliases", []) or []:
            table.setdefault(str(a), r)
    return lambda t: table.get(t.strip())

def extract_links(body: str) -> list:
    return [m.group(1).strip() for m in WIKI_RE.finditer(body)]

# ---------------------------------------------------------------- 命令：add

def cmd_add(args):
    text = args.text
    if not text and args.file:
        text = read(Path(args.file))
    if not text:
        text = sys.stdin.read()
    text = (text or "").strip()
    if not text:
        print(RED("✗ 没有内容可添加")); return 1

    target = INBOX / f"{today()}.md"
    if not target.exists():
        write(target, f"# 收集箱 · {today()}\n")
    block = f"\n## {hhmmss()}"
    if args.source:
        block += f"  ·  来源：{args.source}"
    block += f"\n\n{text}\n"
    with target.open("a", encoding="utf-8") as f:
        f.write(block)
    print(GRN(f"✓ 已采集到 {rel(target)}"))
    return 0

# ---------------------------------------------------------------- 命令：new

def cmd_new(args):
    cat, title = args.category, args.title
    if cat not in categories() and cat not in (TAXONOMY.read_text(encoding="utf-8") if TAXONOMY.exists() else ""):
        print(YEL(f"⚠ 分类「{cat}」不在 taxonomy 中，仍会创建。建议先同步 meta/taxonomy.md"))
    p = KNOWLEDGE / cat / f"{slugify(title)}.md"
    if p.exists() and not args.force:
        print(RED(f"✗ 已存在：{rel(p)}（加 --force 覆盖）")); return 1
    tpl = read(TEMPLATES / "note.md") if (TEMPLATES / "note.md").exists() else ""
    prefix = ""
    if tpl:
        fm, body = parse_frontmatter(tpl)
    else:
        fm, body = {}, "\n## 要点\n\n"
    fm.update({
        "id": dt.datetime.now().strftime("%Y%m%d%H%M%S"),
        "title": title,
        "category": cat,
        "tags": fm.get("tags", []),
        "status": fm.get("status", "seed"),
        "created": today(),
        "updated": today(),
    })
    write(p, dump_frontmatter(fm) + (body.lstrip("\n") if body.startswith("\n") else body))
    append_ledger({"ts": now_iso(), "action": "new", "note": rel(p), "agent": args.agent})
    print(GRN(f"✓ 新建笔记 {rel(p)}"))
    return 0

# ---------------------------------------------------------------- 命令：status

def count_inbox():
    files = []
    if INBOX.exists():
        for p in sorted(INBOX.glob("*.md")):
            body = read(p)
            n = len(re.findall(r"^##\s", body, re.M))
            files.append((p, max(n, 0)))
    return files

def review_items():
    if not REVIEW.exists():
        return []
    return [p for p in sorted(REVIEW.glob("*.md")) if p.name != "README.md"]

def cmd_status(args):
    pending = count_inbox()
    n_snip = sum(n for _, n in pending)

    notes = list(iter_notes())
    n_notes = len(notes)
    cats = {}
    for _, fm, _ in notes:
        cats[str(fm.get("category", "未分类"))] = cats.get(str(fm.get("category", "未分类")), 0) + 1

    review_n = len(review_items())
    ledger = load_ledger()
    last = ledger[-1]["ts"] if ledger else "—"

    issues = collect_issues()

    print(BOLD("knowleger-repo · 知识库状态"))
    print(DIM("─" * 46))
    if pending:
        detail = "，".join(f"{p.stem}({n})" for p, n in pending)
        print(f"📥 收集箱    {YEL(f'{len(pending)} 个文件 / {n_snip} 条片段待整理')}  {DIM(detail)}")
    else:
        print(f"📥 收集箱    {GRN('空，已全部整理')}")
    print(f"📚 知识库    {CYA(f'{n_notes} 篇笔记')} / {len(cats)} 个分类  {DIM(' '.join(f'{k}:{v}' for k, v in sorted(cats.items())))}")
    print(f"🔍 待裁决    {RED(str(review_n)) if review_n else GRN('0')} 条  {DIM('（AI 不确定的都进 review/，等你拍板）')}")
    print(f"📜 台账      {len(ledger)} 条记录，上次整理 {CYA(last)}")
    if issues:
        print(f"🩺 健康度    {YEL(f'{len(issues)} 个提示')}  {DIM('运行 kb lint 查看详情')}")
    else:
        print(f"🩺 健康度    {GRN('良好')}")
    return 0

# ---------------------------------------------------------------- 命令：process

def available_ollama_models():
    if not have("ollama"):
        return []
    rc, out, _ = run_capture(["ollama", "list"])
    if rc != 0:
        return []
    return [l.split()[0] for l in out.splitlines()[1:] if l.strip()]

def pick_local_model(cfg):
    """返回 (模型名, 提示语)。配置的模型不在本地时，自动退到第一个可用模型。"""
    want = cfg["local_model"]
    models = available_ollama_models()
    if not models:
        return want, "没有检测到本地模型：先 `brew services start ollama`，再 `ollama pull " + want + "`"
    if want in models:
        return want, ""
    return models[0], f"配置的 {want} 不在本地，自动改用 {models[0]}"

def dispatch_agent(prompt: str, local: bool = False, tag: str = "task") -> int:
    """把任务书交给 AI 执行。

    非 local：调用 AI CLI（默认 `opencode run`），它有文件权限，会真正落盘。
    local  ：调用本地模型（Ollama）。本地模型没有文件工具，只会产出「草稿」，
             存到 .kb-out/ 供你或大模型二次应用。价值在于零成本的初筛/打标/判重。
    """
    cfg = load_config()
    if local:
        model, note = pick_local_model(cfg)
        if note:
            print(YEL(f"⚠ {note}"))
        tmpl = os.environ.get("KB_LOCAL_CMD", cfg["local_agent_cmd"])
        cmd = tmpl.format(model=model)
    else:
        cmd = os.environ.get("KB_AGENT_CMD", cfg["agent_cmd"])
    argv = cmd.split()
    if not argv:
        print(RED("✗ 未配置 agent 命令")); return 1
    if not have(argv[0]):
        print(RED(f"✗ 找不到命令 `{argv[0]}`"))
        print(DIM("  · 安装 opencode，或改 .kbconfig.json 的 agent_cmd"))
        print(DIM("  · 或改用 --local 走本地 Ollama（零 API 成本，产出草稿）"))
        return 1
    print(DIM(f"$ {cmd} <任务书 {len(prompt)} 字符>"))

    if local:
        try:
            p = subprocess.run(argv, cwd=str(ROOT), input=prompt,
                               capture_output=True, text=True)
        except FileNotFoundError:
            print(RED("✗ 找不到本地模型命令")); return 1
        if p.returncode != 0 and not (p.stdout or "").strip():
            print(RED(f"✗ 本地模型失败：{(p.stderr or '').strip()[:300]}"))
            return p.returncode
        out = (p.stdout or "").strip()
        print(out if out else DIM("（模型没有输出）"))
        if out:
            outdir = ROOT / ".kb-out"
            outdir.mkdir(exist_ok=True)
            fn = outdir / f"{dt.datetime.now().strftime('%Y%m%d-%H%M%S')}-{tag}-draft.md"
            write(fn, f"<!-- 本地模型 {model} 生成的草稿，尚未应用进知识库 -->\n\n{out}\n")
            print(DIM(f"\n（草稿已存 {rel(fn)}。本地模型没有文件权限，"
                      f"需要你或大模型把它应用进 knowledge/）"))
        return 0
    return run_stream(argv + [prompt])

def cmd_process(args):
    pending = count_inbox()
    if not pending:
        print(GRN("✓ 收集箱为空，无需整理"))
        return 0

    parts = []
    parts.append("# AI 整理任务（Ingest）\n")
    parts.append("请严格按仓库根目录 `AGENTS.md` 第 4.1 节「Ingest 工作流」执行。\n")
    parts.append("## 待整理的收集箱文件\n")
    for p, n in pending:
        parts.append(f"### {rel(p)}（{n} 条片段）\n")
        parts.append(read(p).strip() + "\n")

    parts.append("\n## 知识库现有笔记（判重参考，**不要重复创建**）\n")
    existing = [(str(fm.get("category", "")), note_title(p, fm)) for p, fm, _ in iter_notes()]
    if existing:
        for cat, t in existing:
            parts.append(f"- {cat} / {t}")
    else:
        parts.append("（暂无）")

    parts.append("\n## 交付要求\n")
    parts.append("1. 拆成原子笔记写入 `knowledge/<分类>/`，frontmatter 字段齐全")
    parts.append("2. 用 `[[标题]]` 建立**双向**链接，更新 `maps/` 主题地图")
    parts.append("3. 把「原始片段 → 生成笔记」的对应关系追加到 `meta/ledger.jsonl`")
    parts.append("4. 拿不准的（重复/矛盾）写进 `review/`，不要擅自合并")
    parts.append("5. 处理完运行 `kb archive` 归档原始片段，再 `kb index && kb lint && kb build`")
    parts.append("6. 最后 git commit，让这次整理成为可回滚的 diff\n")

    prompt = "\n".join(parts)

    if args.out:
        write(Path(args.out), prompt)
        print(GRN(f"✓ 整理任务已写出到 {args.out}"))
        return 0

    if args.run or args.local:
        return dispatch_agent(prompt, local=args.local, tag="ingest")

    print(prompt)
    return 0

# ---------------------------------------------------------------- 命令：archive

def cmd_archive(args):
    targets = []
    if args.files:
        targets = [INBOX / f if not f.startswith("inbox/") else ROOT / f for f in args.files]
    else:
        targets = sorted(INBOX.glob("*.md"))
    if not targets:
        print(DIM("收集箱为空")); return 0
    ARC_README = ARCHIVE / "README.md"
    ARCHIVE.mkdir(parents=True, exist_ok=True)
    if not ARC_README.exists():
        write(ARC_README, "# 归档\n\n已整理过的原始片段，按日期留存，**永不删除**。\n")
    moved = 0
    for t in targets:
        if t.exists() and t.suffix == ".md" and t.parent == INBOX:
            dst = ARCHIVE / t.name
            if dst.exists():
                dst = ARCHIVE / f"{t.stem}-{dt.datetime.now().strftime('%H%M%S')}{t.suffix}"
            t.rename(dst)
            append_ledger({"ts": now_iso(), "action": "archive", "from": rel(t), "to": rel(dst)})
            moved += 1
    print(GRN(f"✓ 已归档 {moved} 个文件到 inbox/archive/"))
    return 0

# ---------------------------------------------------------------- 命令：index

def cmd_index(args):
    resolver = build_link_resolver()
    notes = []
    for p, fm, body in iter_notes():
        notes.append({
            "rel": rel(p),
            "title": note_title(p, fm),
            "category": str(fm.get("category", "未分类")),
            "tags": fm.get("tags", []) or [],
            "status": str(fm.get("status", "seed")),
            "updated": str(fm.get("updated", "")),
            "summary": note_summary(body),
            "links": extract_links(body),
        })

    MAPS.mkdir(exist_ok=True)
    # 每个分类一个 MOC
    by_cat = {}
    for n in notes:
        by_cat.setdefault(n["category"], []).append(n)

    for cat, items in sorted(by_cat.items()):
        lines = [AUTOGEN, f"# 地图 · {cat}", ""]
        lines.append(f"> {len(items)} 篇笔记\n")
        for n in sorted(items, key=lambda x: x["title"]):
            tags = " ".join(f"`#{t}`" for t in n["tags"])
            lines.append(f"## [[{n['title']}]]")
            if n["summary"]:
                lines.append(f"{n['summary']}")
            meta = f"<sub>状态 {n['status']} · 更新 {n['updated']}</sub>"
            if tags:
                meta += f"  {tags}"
            lines.append(meta)
            lines.append("")
        write(MAPS / f"{cat}.md", "\n".join(lines))

    # 根索引
    out = [AUTOGEN, "# 知识地图总览", ""]
    out.append(f"> 共 {len(notes)} 篇笔记 · {len(by_cat)} 个分类\n")
    for cat, items in sorted(by_cat.items()):
        out.append(f"## [[{cat}|地图 · {cat}]]（{len(items)}）")
        names = "、".join(f"[[{n['title']}]]" for n in sorted(items, key=lambda x: x["title"]))
        out.append(names)
        out.append("")

    # 标签索引
    tag_map = {}
    for n in notes:
        for t in n["tags"]:
            tag_map.setdefault(t, []).append(n["title"])
    if tag_map:
        out.append("## 标签索引")
        out.append("")
        for t in sorted(tag_map):
            out.append(f"- `#{t}`（{len(tag_map[t])}）：" + "、".join(f"[[{x}]]" for x in sorted(tag_map[t])))
        out.append("")
    write(MAPS / "00-总览.md", "\n".join(out))

    print(GRN(f"✓ 已重建 {len(by_cat) + 1} 个地图文件到 maps/"))
    if qmd_ready():
        if qmd_refresh():
            print(DIM("  · 本地检索索引已刷新（qmd update）"))
            if args.embed:
                print(DIM("  · 正在重建向量索引（qmd embed）…"))
                print(GRN("  · 向量索引已更新") if qmd_embed() else YEL("  · 向量索引更新失败"))
