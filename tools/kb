def cmd_pattern(args):
    if not have("fabric"):
        print(RED("✗ 未安装 fabric。安装：从 github.com/danielmiessler/fabric/releases 下载对应平台二进制。"))
        return 1
    if args.list:
        rc, out, err = run_capture(["fabric", "-l"])
        print(out or err)
        return rc
    text = args.text
    if not text and args.file:
        text = read(Path(args.file))
    if not text:
        text = sys.stdin.read()
    text = (text or "").strip()
    if not text:
        print(RED("✗ 没有输入文本")); return 1
    argv = ["fabric", "--pattern", args.name]
    if args.model:
        argv += ["--model", args.model]
    if args.stream:
        argv.append("--stream")
    # fabric 从 stdin 读；但它的 CLI 也接受管道。统一走 stdout 捕获再回显。
    try:
        p = subprocess.run(argv, cwd=str(ROOT), input=text, text=True,
                           capture_output=True, timeout=args.timeout)
    except FileNotFoundError:
        print(RED("✗ 找不到 fabric")); return 1
    except subprocess.TimeoutExpired:
        print(RED("✗ fabric 超时")); return 1
    if p.returncode != 0:
        print(RED(f"✗ fabric 失败：{(p.stderr or '').strip()[:400]}"))
        return p.returncode
    print(p.stdout)
    if not args.no_save and p.stdout.strip():
        outdir = ROOT / ".kb-out"
        outdir.mkdir(exist_ok=True)
        fn = outdir / f"{dt.datetime.now().strftime('%Y%m%d-%H%M%S')}-{args.name}.md"
        write(fn, f"<!-- fabric pattern: {args.name} -->\n\n" + p.stdout.strip() + "\n")
        print(DIM(f"\n（已另存：{rel(fn)}）"))
    return 0

