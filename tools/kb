#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
kb — knowleger-repo 命令行工具

思路：把知识库当代码仓库来经营。
  采集 = commit（随手扔片段）
  整理 = build/refactor（AI 定期把片段编译成结构化知识）
  git  = 审计日志（每次整理都是可 review、可回滚的 diff）

命令：
  kb add <文本>          采集零星片段到收集箱
  kb new <分类> <标题>   手动新建一篇结构化笔记（也可由 AI 调用）
  kb status              收集箱积压 / 知识库规模 / 健康度 / 上次整理
  kb process             输出 AI 整理任务（协议 + 待处理片段）
  kb archive [文件...]   把已整理的片段归档（永不删除）
  kb index               重建主题地图 MOC（maps/）
  kb lint                知识体检（断链 / 孤儿 / 缺字段 / 积压）
  kb build               生成静态站点到 docs/
  kb log [-n N]          查看整理台账
"""

import argparse
import datetime as dt
import html
import json
import os
import re
import subprocess
import sys
from pathlib import Path

# ---------------------------------------------------------------- 路径常量

ROOT = Path(__file__).resolve().parent.parent
INBOX = ROOT / "inbox"
ARCHIVE = INBOX / "archive"
KNOWLEDGE = ROOT / "knowledge"
MAPS = ROOT / "maps"
REVIEW = ROOT / "review"
META = ROOT / "meta"
TEMPLATES = ROOT / "templates"
DOCS = ROOT / "docs"
LEDGER = META / "ledger.jsonl"
TAXONOMY = META / "taxonomy.md"
AGENTS = ROOT / "AGENTS.md"

AUTOGEN = "<!-- AUTO-GENERATED by `kb index` — 请勿手改，改内容后重新运行 kb index -->"

# ---------------------------------------------------------------- 终端颜色

def _tty():
    return sys.stdout.isatty() and os.environ.get("NO_COLOR") is None

def c(s, col):
    return f"\033[{col}m{s}\033[0m" if _tty() else str(s)

DIM = lambda s: c(s, "2")
BOLD = lambda s: c(s, "1")
RED = lambda s: c(s, "31")
GRN = lambda s: c(s, "32")
YEL = lambda s: c(s, "33")
CYA = lambda s: c(s, "36")
MAG = lambda s: c(s, "35")

# ---------------------------------------------------------------- 基础工具

def read(p: Path) -> str:
    return p.read_text(encoding="utf-8")

def write(p: Path, s: str):
    p.parent.mkdir(parents=True, exist_ok=True)
    p.write_text(s, encoding="utf-8")

def now_iso() -> str:
    return dt.datetime.now().astimezone().replace(microsecond=0).isoformat()

def today() -> str:
    return dt.date.today().isoformat()

def hhmmss() -> str:
    return dt.datetime.now().strftime("%H:%M:%S")

FM_RE = re.compile(r"^---\n(.*?)\n---[ \t]*\n?", re.S)

def parse_value(v: str):
    v = v.strip()
    if v.startswith("[") and v.endswith("]"):
        inner = v[1:-1].strip()
        if not inner:
            return []
        return [x.strip().strip("'\"") for x in inner.split(",")]
    return v.strip().strip("'\"")

def parse_frontmatter(text: str):
    """返回 (frontmatter dict, body)。无 frontmatter 时返回 ({}, 原文)。"""
    m = FM_RE.match(text)
    if not m:
        return {}, text
    fm = {}
    for line in m.group(1).splitlines():
        if not line.strip() or line.lstrip().startswith("#") or ":" not in line:
            continue
        k, v = line.split(":", 1)
        fm[k.strip()] = parse_value(v)
    return fm, text[m.end():]

FM_ORDER = ["id", "title", "category", "tags", "status", "created", "updated", "sources", "related"]

def dump_frontmatter(fm: dict) -> str:
    keys = [k for k in FM_ORDER if k in fm] + [k for k in fm if k not in FM_ORDER]
    lines = ["---"]
    for k in keys:
        v = fm[k]
        if isinstance(v, list):
            lines.append(f"{k}: [{', '.join(str(x) for x in v)}]")
        else:
            lines.append(f"{k}: {v}")
    lines.append("---")
    return "\n".join(lines) + "\n"

def slugify(s: str) -> str:
    s = s.strip().replace("/", "／")
    s = re.sub(r"\s+", "-", s)
    s = re.sub(r"[\"'`\\:*?<>|\n\r\t]+", "", s)
    return s[:120]

def rel(p: Path) -> str:
    try:
        return str(p.relative_to(ROOT))
    except ValueError:
        return str(p)

def iter_notes():
    """遍历知识库笔记，返回 (path, fm, body)。"""
    if not KNOWLEDGE.exists():
        return
    for p in sorted(KNOWLEDGE.rglob("*.md")):
        if p.name.startswith("_") or p.name.startswith("."):
            continue
        fm, body = parse_frontmatter(read(p))
        yield p, fm, body

def note_title(p: Path, fm: dict) -> str:
    return str(fm.get("title") or p.stem)

def note_summary(body: str, n: int = 120) -> str:
    for line in body.splitlines():
        s = line.strip()
        if not s or s.startswith("#") or s.startswith(">") or s.startswith("```"):
            continue
        s = re.sub(r"\[\[([^\]|]+)(?:\|([^\]]+))?\]\]", lambda m: m.group(2) or m.group(1), s)
        s = re.sub(r"\[([^\]]+)\]\([^)]+\)", r"\1", s)
        s = re.sub(r"[*`]", "", s)
        return s[:n] + ("…" if len(s) > n else "")
    return ""

def categories() -> list:
    if not KNOWLEDGE.exists():
        return []
    return sorted([d.name for d in KNOWLEDGE.iterdir() if d.is_dir() and not d.name.startswith(".")])

def load_ledger() -> list:
    if not LEDGER.exists():
        return []
    out = []
    for line in read(LEDGER).splitlines():
        line = line.strip()
        if line:
            try:
                out.append(json.loads(line))
            except json.JSONDecodeError:
                pass
    return out

def append_ledger(entry: dict):
    LEDGER.parent.mkdir(parents=True, exist_ok=True)
    with LEDGER.open("a", encoding="utf-8") as f:
        f.write(json.dumps(entry, ensure_ascii=False) + "\n")

# ---------------------------------------------------------------- 断链解析

WIKI_RE = re.compile(r"\[\[([^\]|]+)(?:\|([^\]]+))?\]\]")

def build_link_resolver():
    """标题/别名/文件名 → 笔记相对路径。返回 resolve(target) -> relpath | None。"""
    table = {}
    for p, fm, body in iter_notes():
        r = rel(p)
        table.setdefault(note_title(p, fm), r)
        table.setdefault(p.stem, r)
        for a in fm.get("aliases", []) or []:
            table.setdefault(str(a), r)
    return lambda t: table.get(t.strip())

def extract_links(body: str) -> list:
    return [m.group(1).strip() for m in WIKI_RE.finditer(body)]

# ---------------------------------------------------------------- 命令：add

def cmd_add(args):
    text = args.text
    if not text and args.file:
        text = read(Path(args.file))
    if not text:
        text = sys.stdin.read()
    text = (text or "").strip()
    if not text:
        print(RED("✗ 没有内容可添加")); return 1

    target = INBOX / f"{today()}.md"
    if not target.exists():
        write(target, f"# 收集箱 · {today()}\n")
    block = f"\n## {hhmmss()}"
    if args.source:
        block += f"  ·  来源：{args.source}"
    block += f"\n\n{text}\n"
    with target.open("a", encoding="utf-8") as f:
        f.write(block)
    print(GRN(f"✓ 已采集到 {rel(target)}"))
    return 0

# ---------------------------------------------------------------- 命令：new

def cmd_new(args):
    cat, title = args.category, args.title
    if cat not in categories() and cat not in (TAXONOMY.read_text(encoding="utf-8") if TAXONOMY.exists() else ""):
        print(YEL(f"⚠ 分类「{cat}」不在 taxonomy 中，仍会创建。建议先同步 meta/taxonomy.md"))
    p = KNOWLEDGE / cat / f"{slugify(title)}.md"
    if p.exists() and not args.force:
        print(RED(f"✗ 已存在：{rel(p)}（加 --force 覆盖）")); return 1
    tpl = read(TEMPLATES / "note.md") if (TEMPLATES / "note.md").exists() else ""
    prefix = ""
    if tpl:
        fm, body = parse_frontmatter(tpl)
    else:
        fm, body = {}, "\n## 要点\n\n"
    fm.update({
        "id": dt.datetime.now().strftime("%Y%m%d%H%M%S"),
        "title": title,
        "category": cat,
        "tags": fm.get("tags", []),
        "status": fm.get("status", "seed"),
        "created": today(),
        "updated": today(),
    })
    write(p, dump_frontmatter(fm) + (body.lstrip("\n") if body.startswith("\n") else body))
    append_ledger({"ts": now_iso(), "action": "new", "note": rel(p), "agent": args.agent})
    print(GRN(f"✓ 新建笔记 {rel(p)}"))
    return 0

# ---------------------------------------------------------------- 命令：status

def count_inbox():
    files = []
    if INBOX.exists():
        for p in sorted(INBOX.glob("*.md")):
            body = read(p)
            n = len(re.findall(r"^##\s", body, re.M))
            files.append((p, max(n, 0)))
    return files

def review_items():
    if not REVIEW.exists():
        return []
    return [p for p in sorted(REVIEW.glob("*.md")) if p.name != "README.md"]

def cmd_status(args):
    pending = count_inbox()
    n_snip = sum(n for _, n in pending)

    notes = list(iter_notes())
    n_notes = len(notes)
    cats = {}
    for _, fm, _ in notes:
        cats[str(fm.get("category", "未分类"))] = cats.get(str(fm.get("category", "未分类")), 0) + 1

    review_n = len(review_items())
    ledger = load_ledger()
    last = ledger[-1]["ts"] if ledger else "—"

    issues = collect_issues()

    print(BOLD("knowleger-repo · 知识库状态"))
    print(DIM("─" * 46))
    if pending:
        detail = "，".join(f"{p.stem}({n})" for p, n in pending)
        print(f"📥 收集箱    {YEL(f'{len(pending)} 个文件 / {n_snip} 条片段待整理')}  {DIM(detail)}")
    else:
        print(f"📥 收集箱    {GRN('空，已全部整理')}")
    print(f"📚 知识库    {CYA(f'{n_notes} 篇笔记')} / {len(cats)} 个分类  {DIM(' '.join(f'{k}:{v}' for k, v in sorted(cats.items())))}")
    print(f"🔍 待裁决    {RED(str(review_n)) if review_n else GRN('0')} 条  {DIM('（AI 不确定的都进 review/，等你拍板）')}")
    print(f"📜 台账      {len(ledger)} 条记录，上次整理 {CYA(last)}")
    if issues:
        print(f"🩺 健康度    {YEL(f'{len(issues)} 个提示')}  {DIM('运行 kb lint 查看详情')}")
    else:
        print(f"🩺 健康度    {GRN('良好')}")
    return 0

# ---------------------------------------------------------------- 命令：process

def cmd_process(args):
    pending = count_inbox()
    if not pending:
        print(GRN("✓ 收集箱为空，无需整理"))
        return 0

    parts = []
    parts.append("# AI 整理任务\n")
    parts.append("请严格按仓库根目录 `AGENTS.md` 定义的「整理协议」执行以下工作：\n")
    parts.append("## 待整理的收集箱文件\n")
    for p, n in pending:
        parts.append(f"### {rel(p)}（{n} 条片段）\n")
        parts.append(read(p).strip() + "\n")
    parts.append("\n## 交付要求\n")
    parts.append("1. 拆成原子笔记写入 `knowledge/<分类>/`，frontmatter 字段齐全")
    parts.append("2. 用 `[[标题]]` 建立双向链接，更新 `maps/` 主题地图")
    parts.append("3. 把「原始片段 → 生成笔记」的对应关系追加到 `meta/ledger.jsonl`")
    parts.append("4. 拿不准的（重复/矛盾）写进 `review/`，不要擅自合并")
    parts.append(f"5. 处理完运行 `kb archive` 归档原始片段，再 `kb index && kb build`\n")

    prompt = "\n".join(parts)

    if args.out:
        write(Path(args.out), prompt)
        print(GRN(f"✓ 整理任务已写出到 {args.out}"))
        return 0

    if not args.run:
        print(prompt)
        return 0

    # --run：交给 AI agent 执行
    cmd = os.environ.get("KB_AGENT_CMD", "opencode run")
    argv = cmd.split() + [prompt]
    print(DIM(f"$ {cmd} <整理任务，{len(prompt)} 字符>"))
    try:
        return subprocess.call(argv, cwd=str(ROOT))
    except FileNotFoundError:
        print(RED(f"✗ 找不到命令 `{cmd}`。可设置环境变量 KB_AGENT_CMD 指定你的 AI CLI。"))
        return 1

# ---------------------------------------------------------------- 命令：archive

def cmd_archive(args):
    targets = []
    if args.files:
        targets = [INBOX / f if not f.startswith("inbox/") else ROOT / f for f in args.files]
    else:
        targets = sorted(INBOX.glob("*.md"))
    if not targets:
        print(DIM("收集箱为空")); return 0
    ARC_README = ARCHIVE / "README.md"
    ARCHIVE.mkdir(parents=True, exist_ok=True)
    if not ARC_README.exists():
        write(ARC_README, "# 归档\n\n已整理过的原始片段，按日期留存，**永不删除**。\n")
    moved = 0
    for t in targets:
        if t.exists() and t.suffix == ".md" and t.parent == INBOX:
            dst = ARCHIVE / t.name
            if dst.exists():
                dst = ARCHIVE / f"{t.stem}-{dt.datetime.now().strftime('%H%M%S')}{t.suffix}"
            t.rename(dst)
            append_ledger({"ts": now_iso(), "action": "archive", "from": rel(t), "to": rel(dst)})
            moved += 1
    print(GRN(f"✓ 已归档 {moved} 个文件到 inbox/archive/"))
    return 0

# ---------------------------------------------------------------- 命令：index

def cmd_index(args):
    resolver = build_link_resolver()
    notes = []
    for p, fm, body in iter_notes():
        notes.append({
            "rel": rel(p),
            "title": note_title(p, fm),
            "category": str(fm.get("category", "未分类")),
            "tags": fm.get("tags", []) or [],
            "status": str(fm.get("status", "seed")),
            "updated": str(fm.get("updated", "")),
            "summary": note_summary(body),
            "links": extract_links(body),
        })

    MAPS.mkdir(exist_ok=True)
    # 每个分类一个 MOC
    by_cat = {}
    for n in notes:
        by_cat.setdefault(n["category"], []).append(n)

    for cat, items in sorted(by_cat.items()):
        lines = [AUTOGEN, f"# 地图 · {cat}", ""]
        lines.append(f"> {len(items)} 篇笔记\n")
        for n in sorted(items, key=lambda x: x["title"]):
            tags = " ".join(f"`#{t}`" for t in n["tags"])
            lines.append(f"## [[{n['title']}]]")
            if n["summary"]:
                lines.append(f"{n['summary']}")
            meta = f"<sub>状态 {n['status']} · 更新 {n['updated']}</sub>"
            if tags:
                meta += f"  {tags}"
            lines.append(meta)
            lines.append("")
        write(MAPS / f"{cat}.md", "\n".join(lines))

    # 根索引
    out = [AUTOGEN, "# 知识地图总览", ""]
    out.append(f"> 共 {len(notes)} 篇笔记 · {len(by_cat)} 个分类\n")
    for cat, items in sorted(by_cat.items()):
        out.append(f"## [[地图 · {cat}]]（{len(items)}）")
        names = "、".join(f"[[{n['title']}]]" for n in sorted(items, key=lambda x: x["title"]))
        out.append(names)
        out.append("")

    # 标签索引
    tag_map = {}
    for n in notes:
        for t in n["tags"]:
            tag_map.setdefault(t, []).append(n["title"])
    if tag_map:
        out.append("## 标签索引")
        out.append("")
        for t in sorted(tag_map):
            out.append(f"- `#{t}`（{len(tag_map[t])}）：" + "、".join(f"[[{x}]]" for x in sorted(tag_map[t])))
        out.append("")
    write(MAPS / "00-总览.md", "\n".join(out))

    print(GRN(f"✓ 已重建 {len(by_cat) + 1} 个地图文件到 maps/"))
    return 0

# ---------------------------------------------------------------- 命令：lint

def collect_issues():
    issues = []
    resolver = build_link_resolver()
    notes = list(iter_notes())
    required = ["id", "title", "category", "tags", "status", "created", "updated"]

    title_seen = {}
    inbound = {}
    for p, fm, body in notes:
        r = rel(p)
        for f in required:
            if f not in fm or fm[f] == "":
                issues.append(("warn", f"{r}：缺 frontmatter 字段 `{f}`"))
        cat = str(fm.get("category", ""))
        if cat and cat != p.parent.name:
            issues.append(("warn", f"{r}：category「{cat}」与目录「{p.parent.name}」不一致"))
        t = note_title(p, fm)
        if t in title_seen:
            issues.append(("error", f"标题重复：「{t}」\n    - {title_seen[t]}\n    - {r}"))
        title_seen[t] = r
        for lk in extract_links(body):
            inbound[lk] = inbound.get(lk, 0) + 1
            if not resolver(lk):
                issues.append(("error", f"{r}：断链 [[{lk}]]"))

    # 孤儿：没有任何入链 & 自身没有出链
    for p, fm, body in notes:
        t = note_title(p, fm)
        out_links = extract_links(body)
        if inbound.get(t, 0) == 0 and not out_links:
            issues.append(("info", f"{rel(p)}：孤儿笔记（无入链、无出链）"))

    # 收集箱积压
    for p, n in count_inbox():
        age = (dt.date.today() - dt.date.fromisoformat(p.stem)).days if re.match(r"\d{4}-\d{2}-\d{2}$", p.stem) else 0
        if age >= 7:
            issues.append(("info", f"{rel(p)}：收集箱已积压 {age} 天（运行 kb process 整理）"))

    # 待裁决
    for p in review_items():
        issues.append(("warn", f"{rel(p)}：待在 review/ 中裁决"))
    return issues

def cmd_lint(args):
    issues = collect_issues()
    if not issues:
        print(GRN("✓ 体检通过，没有发现问题"))
        return 0
    order = {"error": 0, "warn": 1, "info": 2}
    icon = {"error": RED("✗ error"), "warn": YEL("⚠ warn "), "info": CYA("ℹ info ")}
    for sev, msg in sorted(issues, key=lambda x: order[x[0]]):
        print(f"{icon[sev]}  {msg}")
    n_err = sum(1 for s, _ in issues if s == "error")
    print(DIM(f"\n共 {len(issues)} 条（{n_err} 个错误）"))
    return 1 if n_err else 0

# ---------------------------------------------------------------- 命令：log

def cmd_log(args):
    ledger = load_ledger()
    if not ledger:
        print(DIM("台账为空")); return 0
    for e in ledger[-args.n:]:
        ts = e.get("ts", "")
        act = e.get("action", "?")
        who = e.get("agent", "")
        detail = e.get("note") or e.get("from") or ""
        extra = ""
        if e.get("from") and act != "archive":
            extra = f"  ← {e['from']}"
        print(f"{DIM(ts)}  {CYA(act.ljust(8))} {detail}{extra} {DIM(who)}")
    return 0

# ---------------------------------------------------------------- 命令：build

def render_inline(s, resolver, current_slug):
    s = html.escape(s, quote=False)
    codes = []
    s = re.sub(r"`([^`]+)`", lambda m: (codes.append(m.group(1)), f"\x00{len(codes)-1}\x00")[1], s)

    def wiki(m):
        target = m.group(1).strip()
        label = html.escape((m.group(2) or target).strip())
        r = resolver(target)
        if r:
            slug = r[:-3].replace("/", "__").replace(" ", "-")
            href = ("../note/" + slug + ".html") if current_slug else ("note/" + slug + ".html")
            return f'<a class="wl" href="{href}">{label}</a>'
        return f'<span class="wl broken" title="断链：{html.escape(target)}">{label}</span>'

    s = WIKI_RE.sub(wiki, s)
    s = re.sub(r"\[([^\]]+)\]\(([^)]+)\)", r'<a href="\2" target="_blank" rel="noopener">\1</a>', s)
    s = re.sub(r"\*\*([^*]+)\*\*", r"<strong>\1</strong>", s)
    s = re.sub(r"(?<!\*)\*([^*]+)\*(?!\*)", r"<em>\1</em>", s)
    s = re.sub(r"\x00(\d+)\x00", lambda m: "<code>" + html.escape(codes[int(m.group(1))]) + "</code>", s)
    return s

def render_md(text, resolver, current_slug=None):
    lines = text.split("\n")
    out, i = [], 0
    while i < len(lines):
        line = lines[i]
        if line.startswith("```"):
            buf, i = [], i + 1
            while i < len(lines) and not lines[i].startswith("```"):
                buf.append(lines[i]); i += 1
            i += 1
            out.append("<pre><code>" + html.escape("\n".join(buf)) + "</code></pre>")
            continue
        m = re.match(r"^(#{1,6})\s+(.*)$", line)
        if m:
            lvl = len(m.group(1))
            out.append(f"<h{lvl}>{render_inline(m.group(2), resolver, current_slug)}</h{lvl}>")
            i += 1; continue
        if re.match(r"^\s*([-*_])\1{2,}\s*$", line):
            out.append("<hr>"); i += 1; continue
        if re.match(r"^\s*[-*+]\s+", line):
            items = []
            while i < len(lines) and re.match(r"^\s*[-*+]\s+", lines[i]):
                items.append(re.sub(r"^\s*[-*+]\s+", "", lines[i])); i += 1
            out.append("<ul>" + "".join(f"<li>{render_inline(x, resolver, current_slug)}</li>" for x in items) + "</ul>")
            continue
        if re.match(r"^\s*\d+\.\s+", line):
            items = []
            while i < len(lines) and re.match(r"^\s*\d+\.\s+", lines[i]):
                items.append(re.sub(r"^\s*\d+\.\s+", "", lines[i])); i += 1
            out.append("<ol>" + "".join(f"<li>{render_inline(x, resolver, current_slug)}</li>" for x in items) + "</ol>")
            continue
        if line.startswith(">"):
            buf = []
            while i < len(lines) and lines[i].startswith(">"):
                buf.append(lines[i].lstrip("> ")); i += 1
            out.append("<blockquote>" + render_md("\n".join(buf), resolver, current_slug) + "</blockquote>")
            continue
        if not line.strip():
            i += 1; continue
        buf = [line]; i += 1
        while i < len(lines) and lines[i].strip() and not re.match(r"^(#{1,6}\s|```|\s*[-*+]\s|\s*\d+\.\s|>)", lines[i]):
            buf.append(lines[i]); i += 1
        out.append("<p>" + render_inline(" ".join(buf), resolver, current_slug) + "</p>")
    return "\n".join(out)

