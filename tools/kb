#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
kb — knowleger-repo 命令行工具

思路：把知识库当代码仓库来经营。
  采集 = commit（随手扔片段）
  整理 = build/refactor（AI 定期把片段编译成结构化知识）
  git  = 审计日志（每次整理都是可 review、可回滚的 diff）

命令：
  kb add <文本>          采集零星片段到收集箱
  kb new <分类> <标题>   手动新建一篇结构化笔记（也可由 AI 调用）
  kb status              收集箱积压 / 知识库规模 / 健康度 / 上次整理
  kb process             生成 Ingest 任务（可 --run 交给 AI，--local 交给本地模型）
  kb ask <问题>          生成 Query 任务（先检索、再引用作答、回写成页）
  kb archive [文件...]   把已整理的片段归档（永不删除）
  kb index               重建主题地图 MOC，并刷新本地检索索引
  kb lint                知识体检（断链 / 孤儿 / 缺字段 / 积压）
  kb find <关键词>       本地检索（QMD 混合检索，无 QMD 时退化为全文匹配）
  kb pattern <名字>      用 fabric 的 pattern 处理文本
  kb doctor              检查本地工具链（ollama / qmd / fabric / AI CLI）
  kb build               生成静态站点到 docs/
  kb log [-n N]          查看整理台账
"""

import argparse
import datetime as dt
import html
import json
import os
import re
import shutil
import subprocess
import sys
from pathlib import Path

# ---------------------------------------------------------------- 路径常量

ROOT = Path(__file__).resolve().parent.parent
INBOX = ROOT / "inbox"
ARCHIVE = INBOX / "archive"
KNOWLEDGE = ROOT / "knowledge"
MAPS = ROOT / "maps"
REVIEW = ROOT / "review"
META = ROOT / "meta"
