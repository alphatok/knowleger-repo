# ---------------------------------------------------------------- 命令：lint

def collect_issues():
    issues = []
    resolver = build_link_resolver()
    notes = list(iter_notes())
    required = ["id", "title", "category", "tags", "status", "created", "updated"]

    title_seen = {}
    inbound = {}
    for p, fm, body in notes:
        r = rel(p)
        for f in required:
            if f not in fm or fm[f] == "":
                issues.append(("warn", f"{r}：缺 frontmatter 字段 `{f}`"))
        cat = str(fm.get("category", ""))
        if cat and cat != p.parent.name:
            issues.append(("warn", f"{r}：category「{cat}」与目录「{p.parent.name}」不一致"))
        t = note_title(p, fm)
        if t in title_seen:
            issues.append(("error", f"标题重复：「{t}」\n    - {title_seen[t]}\n    - {r}"))
        title_seen[t] = r
        for lk in extract_links(body):
            inbound[lk] = inbound.get(lk, 0) + 1
            if not resolver(lk):
                issues.append(("error", f"{r}：断链 [[{lk}]]"))

    # 孤儿：没有任何入链 & 自身没有出链
    for p, fm, body in notes:
        t = note_title(p, fm)
        out_links = extract_links(body)
        if inbound.get(t, 0) == 0 and not out_links:
            issues.append(("info", f"{rel(p)}：孤儿笔记（无入链、无出链）"))

    # 收集箱积压
    for p, n in count_inbox():
        age = (dt.date.today() - dt.date.fromisoformat(p.stem)).days if re.match(r"\d{4}-\d{2}-\d{2}$", p.stem) else 0
        if age >= 7:
            issues.append(("info", f"{rel(p)}：收集箱已积压 {age} 天（运行 kb process 整理）"))

    # 待裁决
    for p in review_items():
        issues.append(("warn", f"{rel(p)}：待在 review/ 中裁决"))
    return issues

def cmd_lint(args):
    issues = collect_issues()
    if not issues:
        print(GRN("✓ 体检通过，没有发现问题"))
        return 0
    order = {"error": 0, "warn": 1, "info": 2}
    icon = {"error": RED("✗ error"), "warn": YEL("⚠ warn "), "info": CYA("ℹ info ")}
    for sev, msg in sorted(issues, key=lambda x: order[x[0]]):
        print(f"{icon[sev]}  {msg}")
    n_err = sum(1 for s, _ in issues if s == "error")
    print(DIM(f"\n共 {len(issues)} 条（{n_err} 个错误）"))
    return 1 if n_err else 0

# ---------------------------------------------------------------- 命令：find

def grep_find(kw, args):
    kl = kw.lower()
    scope = [KNOWLEDGE, INBOX, REVIEW]
    hits = 0
    for base in scope:
        if not base.exists():
            continue
        for p in sorted(base.rglob("*.md")):
            if "archive" in p.parts and not args.all:
                continue
            lines = read(p).splitlines()
            matched = [(i + 1, l) for i, l in enumerate(lines) if kl in l.lower()]
            if not matched:
                continue
            hits += 1
            print(f"\n{BOLD(rel(p))}  {DIM(f'({len(matched)} 处)')}")
            for ln, line in matched[:args.max]:
                hl = re.sub(re.escape(kw), lambda m: MAG(m.group(0)), line, flags=re.I)
                print(f"  {DIM(str(ln).rjust(4))}  {hl[:160]}")
            if len(matched) > args.max:
                print(DIM(f"       … 另有 {len(matched) - args.max} 处"))
    return hits

def print_qmd_results(results, kw):
    shown = 0
    for r in results:
        f = re.sub(r"^qmd://[^/]+/", "", str(r.get("file", "")))
        line = r.get("line")
        score = r.get("score")
        shown += 1
        head = BOLD(f) + (DIM(f":{line}") if line else "")
        if isinstance(score, (int, float)):
            head += "  " + CYA(f"{round(score * 100)}%")
        print(f"\n{head}")
        for s in (r.get("snippet") or "").splitlines():
            s = s.strip()
            if not s or s.startswith("@@"):
                continue
            hl = re.sub(re.escape(kw), lambda m: MAG(m.group(0)), s, flags=re.I)
            print(f"  {hl[:200]}")
    return shown

def cmd_find(args):
    kw = args.keyword

    if args.engine == "grep":
        n = grep_find(kw, args)
        if not n:
            print(YEL(f"没有找到「{kw}」")); return 1
        print(DIM(f"\n命中 {n} 个文件（全文匹配）"))
        return 0

    if not qmd_ready():
        print(YEL("⚠ QMD 未就绪（未安装，或缺少索引）。装好并运行 `qmd init && qmd collection add .` 即可启用。"))
        print(DIM("  本次回退到全文匹配。\n"))
        n = grep_find(kw, args)
        if not n:
            print(YEL(f"没有找到「{kw}」")); return 1
        print(DIM(f"\n命中 {n} 个文件（全文匹配）"))
        return 0

    mode = "hybrid" if args.deep else ("vec" if args.semantic else "lex")
    results, err = qmd_search(kw, mode, args.max)
    if err:
        print(YEL(f"⚠ QMD 检索失败：{err}"))
        print(DIM("  本次回退到全文匹配。\n"))
        n = grep_find(kw, args)
        return 0 if n else 1

    shown = print_qmd_results(results, kw)
    if not shown:
        print(YEL(f"没有找到「{kw}」"))
        return 1
    label = {"lex": "BM25 关键词", "vec": "向量语义", "hybrid": "混合检索 + 重排"}[mode]
    print(DIM(f"\n引擎：QMD · {label} · {shown} 条"))
    if mode != "hybrid":
        print(DIM("  加 --deep 用混合检索+重排，--semantic 用纯语义，--grep 用全文匹配"))
    return 0

# ---------------------------------------------------------------- 命令：ask

def cmd_ask(args):
    q = args.question
    ctx = ""
    if qmd_ready():
        mode = "lex" if args.fast else "hybrid"
        results, err = qmd_search(q, mode, args.context)
        if err and mode == "hybrid":
            results, err = qmd_search(q, "vec", args.context)
        if results:
            header = []
            seen = set()
            for r in results:
                f = re.sub(r"^qmd://[^/]+/", "", str(r.get("file", "")))
                if f and f not in seen:
                    seen.add(f)
                    header.append(f"### {f}")
                    body = (r.get("snippet") or "").strip()
                    header.append("\n".join(l for l in body.splitlines() if l.strip() and not l.startswith("@@")))
                    header.append("")
            ctx = "\n".join(header)

    parts = ["# AI 问答任务\n",
             "请按 `AGENTS.md` 第 4.2 节「Query 工作流」执行：**先检索、再带引用作答、把有价值的答案回写成页**。\n",
             f"## 问题\n\n{q}\n"]
    if ctx:
        parts.append("## 自动检索到的相关材料（本地 QMD 检索，非全部）\n")
        parts.append(ctx + "\n")
    else:
        parts.append("## 自动检索\n\n（QMD 未就绪，请改用 `kb find` 或直接读 `maps/00-总览.md` 自行定位）\n")
    parts.append("## 交付要求\n")
    parts.append("1. 每个事实性结论都要能指回某篇笔记或某个 sources；知识库答不了就直说，不要编造")
    parts.append("2. 若答案有复用价值 → 用 `kb new` 落成新页或在已有页追加小节（台账 `from` 写 `query:<问题摘要>`）")
    parts.append("3. 收尾：`kb index && kb lint && kb build` 后 git commit\n")

    prompt = "\n".join(parts)

    if args.out:
        write(Path(args.out), prompt)
        print(GRN(f"✓ 问答任务已写出到 {args.out}"))
        return 0

    if args.run or args.local:
        return dispatch_agent(prompt, local=args.local, tag="query")

    print(prompt)
    return 0

